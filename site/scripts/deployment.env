# MyCodeSpace hosting on the shared chessclub-site load balancer (also serves the chess club previews).
export DOMAIN=mycodespace.ai
export PARENT_DOMAIN=mycodespace.ai
export SITE_DIR=site
export PROJECT_ID="${PROJECT_ID:-central-trees-497510-h7}"
export BUCKET_NAME="${BUCKET_NAME:-mycodespace-ai-site-central-trees-497510-h7}"
export LB_PROJECT_ID="${LB_PROJECT_ID:-central-trees-497510-h7}"
export EXISTING_LB_NAME="${EXISTING_LB_NAME:-chessclub-site}"
export DNS_PROJECT_ID="${DNS_PROJECT_ID:-central-trees-497510-h7}"
export DNS_ZONE="${DNS_ZONE:-mycodespace}"
export LOCATION="${LOCATION:-europe-north1}"
export STORAGE_CLASS=STANDARD
export LB_MODE=existing
